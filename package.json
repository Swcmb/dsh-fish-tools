{
  "name": "dsh-fish-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "description": "大肥鱼接入总成：两个只读工具、三家插件开关投影、三处第三方补丁与设置界面",
  "keywords": [
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Swcmb/dsh-fish-tools.git"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "license": "MIT"
}
